{
  "name": "cairn-codex",
  "version": "0.1.0-beta.2",
  "private": true,
  "description": "A Pokedex-style collection manager for Grim Dawn items.",
  "author": {
    "name": "Hinne Stolzenberg",
    "email": "HinneStolzenberg@gmail.com"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && npm run audit:release-entry",
    "build:helper": "dotnet build ./src/helper/CairnCodex.GrimDawn/CairnCodex.GrimDawn.csproj",
    "test:helper": "node ./scripts/smoke-helper.mjs",
    "test:helper-client": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-helper-client.mjs && node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-helper-protocol.mjs",
    "benchmark:helper-memory": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/benchmark-helper-memory.mjs",
    "test:native-dependencies": "node ./scripts/test-native-dependencies.mjs",
    "test:discovery": "node ./scripts/test-discovery.mjs",
    "test:diagnostics": "node --experimental-strip-types ./scripts/test-diagnostics.mjs",
    "test:onboarding": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-onboarding.mjs",
    "test:preferences": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-preferences.mjs",
    "test:preference-store": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-preference-file-store.mjs",
    "test:planner": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-planner-setup.mjs",
    "test:notifications": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-notifications.mjs",
    "test:background-jobs": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-background-jobs.mjs",
    "test:collection-session": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-collection-session.mjs",
    "test:quarantine-reconciliation": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-quarantine-reconciliation.mjs",
    "test:ipc-services": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-ipc-services.mjs",
    "test:domain-services": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-system-domain-services.mjs && node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-import-collection-services.mjs && node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-collection-snapshot-cache.mjs && node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-transfer-domain-services.mjs && node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-ipc-domain-error-transport-pr51.mjs",
    "test:safe-mode": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-safe-mode.mjs",
    "test:search": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-search-query.mjs",
    "test:set-semantics": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-set-semantics.mjs",
    "test:theme-contract": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-theme-contract.mjs",
    "test:accessibility": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-accessibility-contract.mjs",
    "generate:app-icon": "node ./scripts/generate-app-icon.mjs",
    "test:app-icon": "node ./scripts/generate-app-icon.mjs --check",
    "test:bounded-results": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-bounded-results.mjs",
    "test:bounded-grid-semantics": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-bounded-grid-semantics.mjs",
    "test:benchmark-harness": "node ./scripts/test-benchmark-process.mjs",
    "test:bounded-grid-semantics:electron": "install-electron && node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-bounded-grid-semantics-electron.mjs",
    "test:sets-bounded-results": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-sets-bounded-results.mjs",
    "test:sets-bounded-results:electron": "install-electron && node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-sets-bounded-results-electron.mjs",
    "test:farming": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-farming-bounded-results.mjs",
    "test:oracle-workspace": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-oracle-workspace.mjs",
    "test:dismantling-workspace": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-dismantling-workspace.mjs",
    "test:skill-explorer-workspace": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-skill-explorer-workspace.mjs",
    "test:leveling-planner-workspace": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-leveling-planner-workspace.mjs",
    "test:research-workspace-parity": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-research-workspace-parity.mjs",
    "test:skill-explorer-workspace:electron": "install-electron && node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-skill-explorer-workspace-electron.mjs",
    "test:supplies-workspace": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-supplies-workspace.mjs",
    "test:mi-workshop-workspace": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-mi-workshop-workspace.mjs && npm run test:screenshot-collection",
    "test:screenshot-collection": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-screenshot-collection.mjs",
    "test:mi-workshop-fixture:electron": "install-electron && node --disable-warning=ExperimentalWarning ./scripts/test-mi-workshop-fixture-electron.mjs",
    "test:collection-materials-workspace": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-collection-materials-workspace.mjs",
    "test:settings-workspace": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-settings-workspace.mjs",
    "test:workspace-sidebar": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-workspace-sidebar.mjs",
    "test:transfers-workspace": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-transfers-workspace.mjs",
    "test:roll-rating": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-roll-rating.mjs",
    "test:roll-rating:electron": "install-electron && node ./scripts/test-roll-category-profile-electron.mjs",
    "test:glossary": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-glossary.mjs",
    "test:glossary:electron": "install-electron && node ./scripts/test-glossary-electron.mjs",
    "test:routes": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-app-routes.mjs && npm run test:roll-rating && npm run test:glossary",
    "test:routes:electron": "npm run test:roll-rating:electron && npm run test:glossary:electron && npm run test:mi-workshop-fixture:electron && node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-app-routes-electron.mjs",
    "test:copy-policy": "node ./scripts/test-product-copy.mjs",
    "test:gdia-backup": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-gdia-backup.mjs",
    "test:gdia-migration": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-gdia-migration.mjs --items 20000",
    "audit:repo": "node ./scripts/audit-repository.mjs",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-windows.ps1",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-release.ps1",
    "package:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-installer.ps1",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-installer.ps1",
    "test:release-local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-release.ps1",
    "preview": "electron-vite preview",
    "audit:dependencies": "node ./scripts/audit-dependencies.mjs",
    "test:dependency-audit": "node ./scripts/test-dependency-audit.mjs",
    "test:dependency-audit:live": "node ./scripts/test-dependency-audit.mjs --live",
    "preverify": "npm run test:helper-client && npm run test:dependency-audit && npm run test:collection-session && npm run test:quarantine-reconciliation && npm run test:verification-boundary && npm run test:transfer-adapters && npm run test:workspace-queries",
    "smoke:desktop": "npm run build:helper && npm run build:verification && node ./scripts/smoke-desktop.mjs",
    "verify": "npm run audit:repo && npm run test:theme-contract && npm run test:accessibility && npm run test:app-icon && npm run test:bounded-results && npm run test:bounded-grid-semantics && npm run test:benchmark-harness && npm run test:sets-bounded-results && npm run test:farming && npm run test:oracle-workspace && npm run test:dismantling-workspace && npm run test:skill-explorer-workspace && npm run test:research-workspace-parity && npm run test:leveling-planner-workspace && npm run test:supplies-workspace && npm run test:mi-workshop-workspace && npm run test:collection-materials-workspace && npm run test:settings-workspace && npm run test:workspace-sidebar && npm run test:transfers-workspace && npm run test:routes && npm run build && npm run build:verification && npm run build:helper && npm run test:release-entry:electron && npm run test:routes:electron && npm run test:workspace-queries:electron && npm run test:bounded-grid-semantics:electron && npm run test:sets-bounded-results:electron && npm run test:skill-explorer-workspace:electron && npm run test:helper && npm run test:native-dependencies && npm run test:discovery && npm run test:diagnostics && npm run test:gdia-backup && npm run test:gdia-migration && npm run test:onboarding && npm run test:preferences && npm run test:preference-store && npm run test:planner && npm run test:notifications && npm run test:background-jobs && npm run test:ipc-services && npm run test:domain-services && npm run test:safe-mode && npm run test:search && npm run test:set-semantics && npm run test:copy-policy",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "build:verification": "npm run typecheck && electron-vite build --mode verification",
    "test:verification-boundary": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-verification-boundary.mjs",
    "audit:release-entry": "node ./scripts/audit-release-entry.mjs",
    "test:release-entry:electron": "install-electron && node ./scripts/test-release-entry-electron.mjs",
    "test:transfer-adapters": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-production-transfer-adapters.mjs",
    "test:workspace-queries:electron": "install-electron && node --disable-warning=ExperimentalWarning ./scripts/test-workspace-queries-electron.mjs",
    "test:workspace-queries": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-archive-workspace-queries.mjs && node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-remote-workspace-page.mjs && node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/test-archive-copy-session.mjs"
  },
  "dependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.9"
  },
  "build": {
    "appId": "com.hinnestolzenberg.cairncodex",
    "productName": "Cairn Codex",
    "asar": true,
    "directories": {
      "app": "dist/builder-app",
      "output": "dist/builder"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/helper-win-x64",
        "to": "helper"
      },
      {
        "from": "dist/prerequisites",
        "to": "prerequisites"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.CAIRN-CODEX.txt"
      },
      "THIRD_PARTY_NOTICES.md",
      "README.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Cairn-Codex-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cairn Codex",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer-prerequisites.nsh"
    }
  }
}
